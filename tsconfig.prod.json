{
  "compilerOptions": {
    "target": "es2018",
    "moduleResolution": "node",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "lib": ["dom", "es2018"],
    "importHelpers": true,
    "esModuleInterop": true,
    "strictNullChecks": false,
    // Only look for types within the submodule's node_modules
    "typeRoots": ["./node_modules/@types"]
  }
}
